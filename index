
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Diseño y visualización de información</title>

        <style>
            /* ESTO ES UN COMENTARIO. ABAJO ENCONTRARÁ MÁS COMENTARIOS */

            /* RESET: Los navegadores traen márgenes y rellenos por defecto que cambian
            según el elemento. Los ponemos todos en cero para empezar desde una base
            pareja y controlar nosotros los espacios. */

            * {
              margin: 0;
              padding: 0;
              box-sizing: border-box;
            }

            /* VARIABLES DE COLOR */

            :root {
              --rojo: #b51f1f;
              --gris-oscuro: #333;
              --gris-medio: #666;
              --gris-claro: #999;
              --borde: #ddd;
            }

            /* LO DEMÁS */

            body {
              font-family: Helvetica, Arial, serif;
              margin: 0;
              color: var(--gris-oscuro);
            }

            .contenedor {
              max-width: 800px;
              margin: 0 auto;
              padding: 0 3rem;
            }


            nav {
              padding: 1.25rem 0;
              font-size: calc(0.65rem + 0.1vw);
              letter-spacing: 0.075rem;
              text-transform: uppercase;
              box-shadow: 0 0 3px var(--borde);
            }

            nav > div.contenedor {
              display: flex;
              justify-content: space-between;
              align-items: center;
            }

            div.nombre-curso {
              color: var(--gris-oscuro);
              font-weight: 700;
            }

            div.nombre-evaluacion {
              color: var(--gris-claro);
            }


            header {
              text-align: center;
              padding: 2rem 1rem;
            }

            h1 {
              margin-top: 2rem;
              font-size: 2.7rem;
              line-height: 1.15;
              color: var(--gris-oscuro);
            }

            h2 {
              font-size: 1.35rem;
              color: var(--rojo);
              margin-top: 0.5rem;
              margin-bottom: 1rem;
              font-style: italic;
              font-weight: 400;
            }

            h3 {
              font-family: Arial, sans-serif;
              font-size: 0.8rem;
              color: var(--gris-medio);
              margin-bottom: 20px;
            }

            h3 a {
              color: var(--gris-oscuro);
            }


            article {
              padding-bottom: 3rem;
            }


            p {
              font-size: 0.92rem;
              line-height: 1.65;
              margin-bottom: 1rem;
            }

            p > em {
              font-style: italic;
              font-weight: 700;
              color: var(--gris-oscuro);
            }


            /* INTRODUCCIÓN */

            .introduccion {
              border-left: 2px solid var(--borde);
              padding-left: 1rem;
              margin-bottom: 2rem;
            }

            .introduccion p {
              font-style: italic;
              font-size: 1rem;
            }


            /* IMÁGENES */

            figure {
              margin: 2rem 0;
              padding: 1rem;
              border: 1px solid var(--borde);
            }

            figure img {
              width: 100%;
              display: block;
              border: 1px solid var(--borde);
            }

            figcaption {
              font-family: Arial, sans-serif;
              font-size: 0.78rem;
              color: var(--gris-medio);
              text-align: center;
              margin-top: 0.6rem;
              font-style: italic;
            }

            .descripcion-imagen {
              font-family: Arial, sans-serif;
              font-size: 0.75rem;
              line-height: 1.5;
              color: var(--gris-medio);
              margin-top: 0.8rem;
              padding-top: 0.8rem;
              border-top: 1px solid var(--borde);
            }

            .descripcion-imagen strong {
              color: var(--rojo);
            }


            /* CUADROS DESTACADOS */

            .destacado {
              border: 1px solid var(--borde);
              background-color: #f7f7f7;
              padding: 1rem;
              margin: 1.5rem 0;
            }

            .destacado p {
              margin-bottom: 0;
              font-size: 0.88rem;
            }


            /* COMPARACIÓN */

            .comparacion {
              display: flex;
              justify-content: space-between;
              margin: 1.5rem 0 2rem;
            }

            .comparacion .destacado {
              width: 48%;
              margin: 0;
              background-color: white;
            }


            footer {
              box-shadow: 0 0 3px var(--borde);
              padding: 1.25rem 0;
              text-align: center;
              font-family: Arial, sans-serif;
              font-size: calc(0.65rem + 0.1vw);
              letter-spacing: 0.075rem;
              color: var(--rojo);
            }


            /* AJUSTE PARA PANTALLAS PEQUEÑAS */

            @media (max-width: 600px) {

              .contenedor {
                padding: 0 1.5rem;
              }

              nav > div.contenedor {
                display: block;
              }

              h1 {
                font-size: 2rem;
              }

              .comparacion {
                display: block;
              }

              .comparacion .destacado {
                width: 100%;
                margin-bottom: 1rem;
              }
            }

        </style>
